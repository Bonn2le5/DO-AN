# PayOS: lấy ở https://my.payos.vn → Kênh thanh toán.
# Webhook URL đăng ký trên dashboard: https://<domain-công-khai>/api/thanh-toan/payos/webhook/
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://127.0.0.1:8000/api/thanh-toan/payos/return/
PAYOS_CANCEL_URL=http://127.0.0.1:8000/api/thanh-toan/payos/return/

# Browser redirect after PayOS returns to the backend.
USE_REDIS_CHANNEL_LAYER=True
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CHANNEL_URL=redis://127.0.0.1:6379/2

# Trợ lý gọi món AI (bỏ trống thì trợ lý báo chưa sẵn sàng; nút gợi ý nhanh vẫn chạy).
OPENAI_API_KEY=
OPENAI_MODEL=
# Cổng tương thích OpenAI (Responses API). Bỏ trống = https://api.openai.com/v1
OPENAI_BASE_URL=
TRO_LY_DUNG_LLM=True
