# VNPay sandbox credentials: obtain these from your VNPay sandbox merchant account.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/payments/vnpay/return/

# Browser redirect after VNPay returns to the backend.
USE_REDIS_CHANNEL_LAYER=True
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CHANNEL_URL=redis://127.0.0.1:6379/2