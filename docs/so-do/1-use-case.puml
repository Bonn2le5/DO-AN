@startuml
title Sơ đồ ca sử dụng tổng quát — Hệ thống nhà hàng Mộc
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FDF8F0
  BorderColor #8A6A3B
}

actor "Khách vãng lai" as Guest
actor "Khách hàng" as KH
actor "Nhân viên" as NV
actor "Quản lý chi nhánh" as QL
actor "Quản trị viên" as QTV
actor "Cổng VNPay" as VNPay <<hệ thống>>

Guest <|-- KH
NV <|-- QL
QL <|-- QTV

rectangle "Hệ thống nhà hàng Mộc" {
  package "Khách" {
    usecase "Xem thực đơn, món ăn" as UC_Menu
    usecase "Xem chi nhánh, bản đồ" as UC_Branch
    usecase "Xem khuyến mãi, bài viết" as UC_Promo
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Xác thực email" as UC_Verify
    usecase "Đăng nhập" as UC_Login
    usecase "Đặt bàn trực tuyến" as UC_Reserve
    usecase "Gọi món trước" as UC_PreOrder
    usecase "Thanh toán cọc qua VNPay" as UC_Deposit
    usecase "Hủy đặt bàn" as UC_Cancel
    usecase "Xem lịch sử đặt bàn" as UC_History
    usecase "Đánh giá món ăn" as UC_Review
    usecase "Chat với nhà hàng" as UC_Chat
    usecase "Quản lý hồ sơ, đổi mật khẩu" as UC_Profile
  }

  package "Nhân viên" {
    usecase "Xác nhận / cập nhật đặt bàn" as UC_Confirm
    usecase "Check-in khách" as UC_CheckIn
    usecase "Xếp bàn, mở phiên phục vụ" as UC_Seat
    usecase "Tạo phiên khách vãng lai" as UC_WalkIn
    usecase "Gọi món, chuyển bàn" as UC_Order
    usecase "Thanh toán hóa đơn (check-out)" as UC_Checkout
    usecase "Ghi nhận hoàn cọc" as UC_Refund
    usecase "Trả lời chat khách" as UC_ChatReply
  }

  package "Quản lý / Quản trị" {
    usecase "Quản lý bàn, phòng" as UC_Tables
    usecase "Quản lý kho nguyên liệu" as UC_Stock
    usecase "Quản lý nhân viên chi nhánh" as UC_Staff
    usecase "Xem thống kê (dashboard)" as UC_Dash
    usecase "Quản lý món ăn, danh mục" as UC_Foods
    usecase "Quản lý khuyến mãi, bài viết" as UC_Content
    usecase "Kiểm duyệt đánh giá" as UC_Moderate
    usecase "Cấu hình chính sách cọc" as UC_Policy
    usecase "Quản lý người dùng, vai trò" as UC_Roles
  }
}

Guest --> UC_Menu
Guest --> UC_Branch
Guest --> UC_Promo
Guest --> UC_Register
Guest --> UC_Login

KH --> UC_Reserve
KH --> UC_Cancel
KH --> UC_History
KH --> UC_Review
KH --> UC_Chat
KH --> UC_Profile

UC_Register ..> UC_Verify : <<include>>
UC_Reserve ..> UC_Login : <<include>>
UC_PreOrder ..> UC_Reserve : <<extend>>
UC_Deposit ..> UC_PreOrder : <<extend>>\n(giỏ có món)
UC_Deposit --> VNPay

NV --> UC_Confirm
NV --> UC_CheckIn
NV --> UC_Seat
NV --> UC_WalkIn
NV --> UC_Order
NV --> UC_Checkout
NV --> UC_Refund
NV --> UC_ChatReply
UC_Seat ..> UC_CheckIn : <<include>>

QL --> UC_Tables
QL --> UC_Stock
QL --> UC_Staff
QL --> UC_Dash

QTV --> UC_Foods
QTV --> UC_Content
QTV --> UC_Moderate
QTV --> UC_Policy
QTV --> UC_Roles
@enduml
