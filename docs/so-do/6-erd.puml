@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
title Thực thể và quan hệ: người dùng, chi nhánh, bàn, đặt bàn và thanh toán
entity nguoi_dung {
  * id
  --
  thu_dien_tu
  ho_ten
  so_dien_thoai
  chi_nhanh_quan_ly_id
}
entity vai_tro {
  * id
  --
  ma
  ten
}
entity quyen_han {
  * id
  --
  ma
  module
}
entity chi_nhanh {
  * id
  --
  ten
  dia_chi
  toa_do_gis (geography Point 4326)
}
entity ban_an {
  * id
  --
  chi_nhanh_id
  ma_ban
  suc_chua
  trang_thai
}
entity dat_ban {
  * id
  --
  nguoi_dung_id
  chi_nhanh_id
  ban_an_id
  ngay_dat, gio_bat_dau
  so_luong_khach
  hinh_thuc
  so_tien_coc, trang_thai_coc
  trang_thai, phien_ban
}
entity phien_phuc_vu {
  * id
  --
  ban_an_id
  dat_ban_id
  trang_thai
}
entity don_hang {
  * id
  --
  khach_hang_id
  chi_nhanh_id
  phien_phuc_vu_id
  khuyen_mai_id
  tien_hang, tien_giam, tong_tien
  trang_thai
}
entity thanh_toan {
  * id
  --
  don_hang_id / dat_ban_id
  phuong_thuc, so_tien
  ma_giao_dich, trang_thai
}
entity phieu_hoan_tien {
  * id
  --
  dat_ban_id
  thanh_toan_id
  so_tien_hoan
}
nguoi_dung }o--o{ vai_tro
vai_tro }o--o{ quyen_han
chi_nhanh ||--o{ ban_an
chi_nhanh ||--o{ dat_ban
nguoi_dung ||--o{ dat_ban
ban_an |o--o{ dat_ban
ban_an ||--o{ phien_phuc_vu
dat_ban |o--o| phien_phuc_vu
phien_phuc_vu |o--o| don_hang
don_hang ||--o{ thanh_toan
dat_ban ||--o{ thanh_toan
dat_ban ||--o{ phieu_hoan_tien
@enduml
