@startuml
title Sơ đồ tuần tự — Đặt bàn kèm gọi món và thanh toán cọc VNPay
autonumber
skinparam sequenceMessageAlign center
skinparam participant {
  BackgroundColor #FDF8F0
  BorderColor #8A6A3B
}

actor "Khách hàng" as KH
participant "Giao diện React\n(ReservationPage)" as FE
participant "DatBanViewSet" as DBV
participant "DichVuDatBan" as SV
participant "ThanhToanViewSet" as TTV
participant "VNPayService" as VNS
database "CSDL" as DB
participant "Cổng VNPay" as VNPay

== Bước 1: Chọn chỗ ==
KH -> FE : Chọn chi nhánh, ngày, giờ, số người
FE -> DBV : GET /reservations/khung-gio-trong/
DBV -> DB : Đếm số khách đã đặt theo khung giờ
DB --> DBV : Sức chứa còn lại
DBV --> FE : Danh sách khung giờ trống

== Bước 2–3: Gọi món và xác nhận ==
KH -> FE : Thêm món, nhập họ tên, SĐT
FE -> FE : Kiểm tra dữ liệu, tính cọc dự kiến
KH -> FE : Bấm "Thanh toán cọc & đặt chỗ"
FE -> DBV : POST /reservations/ (Bearer JWT)
DBV -> DBV : Kiểm tra đăng nhập, validate serializer
DBV -> SV : tao_dat_ban(nguoi_dung, du_lieu)
SV -> DB : Khóa chi nhánh (select_for_update)
SV -> DB : tinh_suc_chua_con_lai()
alt Không đủ chỗ
  SV --> DBV : ValidationError
  DBV --> FE : 400 "Khung giờ chỉ còn N chỗ"
  FE --> KH : Hiển thị lỗi
else Đủ chỗ
  SV -> DB : Lấy chính sách cọc của chi nhánh
  SV -> SV : so_tien_coc = tiền món × % cọc
  SV -> DB : INSERT DatBan (trạng thái "Chờ xác nhận")
  SV -> DB : INSERT MonAnTrongDatBan
  SV --> DBV : dat_ban
  DBV --> FE : 201 Created (id, so_tien_coc)
end

== Thanh toán cọc ==
FE -> TTV : POST /payments/vnpay/create/ (dat_ban_id)
TTV -> DB : Kiểm tra chủ đặt bàn, trạng thái cọc
TTV -> DB : Tạo ThanhToan (Chờ xử lý)
TTV -> VNS : create_payment_url()
VNS --> TTV : payment_url (đã ký HMAC)
TTV --> FE : payment_url, hết hạn sau 15 phút
FE -> VNPay : Chuyển hướng tới trang thanh toán
KH -> VNPay : Nhập thông tin, xác nhận trả tiền

par IPN (server → server)
  VNPay -> TTV : GET /payments/vnpay/ipn/
  TTV -> VNS : process_ipn() — kiểm tra chữ ký, số tiền
  VNS -> DB : ThanhToan = Thành công\nDatBan.trang_thai_coc = Thành công
  TTV --> VNPay : RspCode 00
else Return (trình duyệt)
  VNPay -> TTV : GET /payments/vnpay/return/
  TTV -> VNS : process_ipn() (idempotent)
  TTV --> FE : Redirect /dat-ban/thanh-toan-ket-qua?status=success
end
FE --> KH : "Đã nhận cọc và đặt chỗ"
@enduml
