@startuml
skinparam defaultFontName Arial
skinparam shadowing false
title Sơ đồ tuần tự gửi tin nhắn chat thời gian thực
autonumber
actor "Khách hàng" as KH
participant "Cửa sổ chat\n(React)" as FE
participant "JWT Middleware\n(ASGI)" as MW
participant "ChatConsumer" as CC
database "PostgreSQL" as DB
queue "Redis\nChannel Layer" as RD
participant "Trang chat\nnhân viên" as NV

== Kết nối ==
FE -> MW : WebSocket /ws/chat/{id}/?token=JWT
MW -> MW : Xác minh token, gắn user vào scope
MW -> CC : connect()
alt Chưa đăng nhập
  CC --> FE : close(4401)
else Không phải hội thoại của mình
  CC --> FE : close(4403)
else Hợp lệ
  CC -> RD : group_add("chat_{id}")
  CC --> FE : connection_established
  CC -> CC : Hẹn giờ đóng khi JWT hết hạn
end

== Gửi tin nhắn ==
KH -> FE : Nhập và gửi tin
FE -> CC : {action: "send_message", content}
alt Rỗng hoặc dài hơn 5.000 ký tự
  CC --> FE : {type: "error"}
else Hợp lệ
  CC -> DB : Lưu TinNhan (trước khi phát)
  DB --> CC : Tin nhắn đã lưu
  CC -> RD : group_send("chat_{id}", chat_message)
  RD --> FE : chat_message
  RD --> NV : chat_message
  CC -> RD : group_send("staff_inbox", inbox_update)
  RD --> NV : Cập nhật hộp thư, số tin chưa đọc
end
@enduml
