@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
title Thực thể và quan hệ: thực đơn, kho, đơn hàng, gợi ý AI và chat
entity danh_muc {
  * id
  --
  ten
}
entity mon_an {
  * id
  --
  danh_muc_id
  ten, duong_dan
  don_gia_hien_tai
  do_cay, la_mon_chay
}
entity nguyen_lieu {
  * id
  --
  ten, don_vi
  ton_kho_hien_tai
  ton_kho_toi_thieu
}
entity dinh_muc_nguyen_lieu {
  * mon_an_id
  --
  * nguyen_lieu_id
  so_luong_can
}
entity don_hang {
  * id
  --
  khach_hang_id
  chi_nhanh_id
  phien_phuc_vu_id
  khuyen_mai_id
  tien_hang, tien_giam, tong_tien
  trang_thai
}
entity chi_tiet_don_hang {
  * id
  --
  don_hang_id
  mon_an_id
  so_luong, don_gia_luc_dat
}
entity danh_gia {
  * id
  --
  nguoi_dung_id
  mon_an_id
  chi_tiet_don_hang_id
  diem_danh_gia
}
entity nguoi_dung {
  * id
  --
  thu_dien_tu
  ho_ten
  so_dien_thoai
  chi_nhanh_quan_ly_id
}
entity tuong_tac_mon_an {
  * id
  --
  nguoi_dung_id
  mon_an_id
  loai_tuong_tac, trong_so
}
entity goi_y_mon_an {
  * id
  --
  nguoi_dung_id
  mon_an_id
  diem_tuong_dong
  ly_do_goi_y, thu_hang
}
entity hoi_thoai {
  * id
  --
  khach_hang_id
  nhan_vien_id
}
entity tin_nhan {
  * id
  --
  hoi_thoai_id
  nguoi_gui_id
  noi_dung
}
danh_muc ||--o{ mon_an
mon_an ||--o{ dinh_muc_nguyen_lieu
nguyen_lieu ||--o{ dinh_muc_nguyen_lieu
don_hang ||--|{ chi_tiet_don_hang
mon_an ||--o{ chi_tiet_don_hang
nguoi_dung ||--o{ tuong_tac_mon_an
mon_an ||--o{ tuong_tac_mon_an
nguoi_dung ||--o{ goi_y_mon_an
nguoi_dung ||--o{ hoi_thoai
hoi_thoai ||--o{ tin_nhan
chi_tiet_don_hang ||--o| danh_gia
@enduml
