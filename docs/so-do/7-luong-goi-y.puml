@startuml
skinparam defaultFontName Arial
skinparam shadowing false
title Luồng tính gợi ý món ăn (Content-Based Filtering)
start
:Khách mở trang chủ / trang chi tiết món;
:Lấy danh sách món đang bán\n(con_hang = True, hien_thi = True);
if (Khách đã đăng nhập và có tương tác?) then (có)
  :Tách từ khóa mỗi món: tên, danh mục, mô tả,\nnguyên liệu, thẻ, vị cay, món chay;
  :Tính TF-IDF (TF dưới tuyến tính, IDF làm trơn),\nchuẩn hóa L2 → vector món;
  :Gộp tương tác theo món: tổng trọng số\n(xem=1, thích=2, đặt=4, đánh giá=5);
  :Vector khẩu vị = Σ trọng số × vector món,\nchuẩn hóa L2;
  :Cosine(vector khẩu vị, vector món) cho mọi món;
  :Ưu tiên món chưa tương tác (khám phá),\nsinh lý do từ món liên quan nhất + đặc trưng chung;
else (không)
  :Cold-start: điểm = 0,6·(lượt đánh giá / max)\n+ 0,4·(điểm đánh giá / 5);
  :Lý do: "Phổ biến hôm nay";
endif
:Lấy Top-N, lưu bảng goi_y_mon_an (cache);
:Trả kết quả kèm lý do gợi ý;
:Ghi sự kiện hiển thị / nhấp / gọi món (su_kien_goi_y)\nđể đo CTR và tỉ lệ chuyển đổi;
stop
@enduml
