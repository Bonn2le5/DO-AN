{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moc-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "moc-frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "moc-backend",
      "runtimeExecutable": "moc-backend/.venv/bin/python",
      "runtimeArgs": ["moc-backend/manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    }
  ]
}
